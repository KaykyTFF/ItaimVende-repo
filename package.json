{
  "name": "itaim-vende",
  "version": "1.0.0",
  "description": "Itaim Vende - Plataforma de Compra, Venda e Trocas",
  "private": true,
  "scripts": {
    "start": "npm --prefix backend run start",
    "dev": "npm --prefix backend run dev",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "build:sessao": "node scripts/build-sessao.js",
    "build:api": "node scripts/build-api.js",
    "build:foto": "node scripts/build-foto.js",
    "build:componentes": "node scripts/build-componentes.js",
    "build:core": "node scripts/build-sessao.js && node scripts/build-api.js && node scripts/build-foto.js && node scripts/build-componentes.js",
    "dev:frontend": "npx -y serve frontend -p 5500",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend run start",
    "install:backend": "npm --prefix backend install"
  },
  "keywords": [
    "marketplace",
    "itaim-vende",
    "ecommerce"
  ],
  "author": "Kayky Terles",
  "license": "ISC"
}
