# Porta do servidor
PORT=3000
NODE_ENV=production

# String de conexão do banco (SQLite local ou PostgreSQL em produção no Neon/Supabase)
# Exemplo PostgreSQL: postgresql://usuario:senha@ep-xyz.us-east-1.neon.tech/itaim_vende?sslmode=require
DATABASE_URL="file:./dev.db"

# Segredo para assinatura de tokens JWT (gere uma string aleatória longa)
JWT_SECRET="seu_jwt_secret_super_seguro_aqui"

# Origens permitidas pelo CORS (ex: https://itaimvende.com.br)
CORS_ORIGIN="*"
