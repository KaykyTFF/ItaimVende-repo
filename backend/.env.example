# Porta e Ambiente de Execução
PORT=3000
NODE_ENV=development

# Conexão com o Banco de Dados PostgreSQL (Supabase / Pooling PgBouncer)
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Autenticação e Sessão JWT
JWT_SECRET="sua_chave_secreta_jwt_longa_e_aleatoria_aqui"
JWT_EXPIRES_IN="2h"
CORS_ORIGIN="*"

# Armazenamento em Nuvem (Supabase Storage)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_KEY="sua_service_role_key_ou_anon_key_aqui"
SUPABASE_BUCKET="marketplace"
STORAGE_PROVIDER="supabase"

# Otimização de Imagens com Sharp (.webp)
IMAGE_OPTIMIZATION_ENABLED="true"
IMAGE_MAX_WIDTH="1600"
IMAGE_QUALITY="82"

# Serviço de E-mail Transacional (Resend ou SMTP)
RESEND_API_KEY=""
EMAIL_FROM="Itaim Vende <onboarding@resend.dev>"
APP_URL="http://localhost:3000"
