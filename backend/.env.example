# Porta do servidor
PORT=3000
NODE_ENV=production

# String de conexão do banco (SQLite local ou PostgreSQL em produção no Neon/Supabase)
# Exemplo PostgreSQL: postgresql://usuario:senha@ep-xyz.us-east-1.neon.tech/itaim_vende?sslmode=require
DATABASE_URL="file:./dev.db"

# Segredo para assinatura de tokens JWT (gere uma string aleatória longa)
JWT_SECRET="seu_jwt_secret_super_seguro_aqui"

# Origens permitidas pelo CORS (ex: https://itaimvende.com.br)
CORS_ORIGIN="*"

# Armazenamento em Nuvem (Supabase Storage)
# Obtenha sua chave no painel do Supabase: Project Settings > API > Project API keys (service_role ou anon)
SUPABASE_URL="https://pgrznndtajjzpwqgtkkz.supabase.co"
SUPABASE_KEY="sua_supabase_key_aqui"
SUPABASE_BUCKET="marketplace"
# Provedor: 'supabase' (nuvem definitiva) ou 'local' (disco local / fallback)
STORAGE_PROVIDER="supabase"

# Otimização Inteligente com Sharp
IMAGE_OPTIMIZATION_ENABLED="true"
IMAGE_MAX_WIDTH="1600"
IMAGE_QUALITY="82"

